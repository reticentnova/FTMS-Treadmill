<?xml version="1.0" encoding="utf-8"?>
<!-- The saved treadmill address is specific to this phone's Bluetooth pairing, so it is not backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
